# Project
PROJECT_NAME=retail-lakehouse-platform
ENVIRONMENT=local

# PostgreSQL source database
POSTGRES_SOURCE_HOST=localhost
POSTGRES_SOURCE_PORT=5432
POSTGRES_SOURCE_DB=retail_source
POSTGRES_SOURCE_USER=retail_source_user
POSTGRES_SOURCE_PASSWORD=change_me

# PostgreSQL warehouse database
POSTGRES_WAREHOUSE_HOST=localhost
POSTGRES_WAREHOUSE_PORT=5433
POSTGRES_WAREHOUSE_DB=retail_warehouse
POSTGRES_WAREHOUSE_USER=retail_warehouse_user
POSTGRES_WAREHOUSE_PASSWORD=change_me

# Local S3-compatible object storage using MinIO
MINIO_ENDPOINT=http://localhost:9000
MINIO_CONSOLE=http://localhost:9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me
MINIO_BUCKET_RAW=retail-raw
MINIO_BUCKET_CURATED=retail-curated
