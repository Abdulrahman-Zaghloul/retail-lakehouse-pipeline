# Project
PROJECT_NAME=retail-lakehouse-platform
ENVIRONMENT=local

# PostgreSQL source database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=retail_source
POSTGRES_USER=retail_user
POSTGRES_PASSWORD=retail_password

# Local S3-compatible object storage using MinIO
MINIO_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET_RAW=retail-raw
MINIO_BUCKET_CURATED=retail-curated

# Warehouse
WAREHOUSE_DB=retail_warehouse
WAREHOUSE_USER=warehouse_user
WAREHOUSE_PASSWORD=warehouse_password
